<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Downloads go on while the app isn't in front: a foreground service of
         the dataSync type (Android 14+ needs the type and its permission), a
         partial wake lock while it runs, and its notification (asked for at
         runtime on Android 13+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name=".SteadfastDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
